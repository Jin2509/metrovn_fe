# =============================================================
# Metro Admin TP.HCM — biến môi trường
# Sao chép file này thành `.env` (hoặc `.env.local`) rồi chỉnh giá trị.
#
# LƯU Ý: chỉ biến có tiền tố VITE_ mới được đưa xuống trình duyệt
# và sẽ lộ công khai trong bundle — KHÔNG đặt bí mật vào biến VITE_*.
# Khai báo kiểu cho mọi biến VITE_* trong src/vite-env.d.ts.
# =============================================================

# Hiện khối tài khoản demo ở trang /login ("false" khi triển khai thật)
VITE_SHOW_DEMO_ACCOUNTS=true

# --- Server (chỉ dùng khi chạy `pnpm start` sau khi build) ---
# PORT=3000
# HOST=0.0.0.0
